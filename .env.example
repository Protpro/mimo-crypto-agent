# ============================================================
# MiMo Crypto Intelligence Agent — Configuration
# ============================================================

# REQUIRED: MiMo API Key
# Get from: https://platform.xiaomimimo.com
MIMO_API_KEY=your_mimo_api_key_here
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=MiMo-V2.5-Pro

# ============================================================
# DATA SOURCES — Real API Keys
# ============================================================

# CoinGecko (FREE, no key needed for basic usage)
# Get optional key: https://www.coingecko.com/en/api/pricing
# Free tier: 10-30 calls/min, basic market data
# Used for: Volume, Price, Market Cap
COINGECKO_API_KEY=

# Etherscan (FREE, key recommended)
# Get key: https://etherscan.io/apis
# Free tier: 5 calls/sec
# Used for: Whale transactions, holder distribution
ETHERSCAN_API_KEY=

# BSCScan (FREE, key recommended)
# Get key: https://bscscan.com/apis
# Free tier: 5 calls/sec
# Used for: BSC whale tracking
BSCSCAN_API_KEY=

# ============================================================
# OPTIONAL — Premium Data Sources
# ============================================================

# Coinglass (PAID — needed for OI, Funding Rate, Liquidation)
# Get key: https://www.coinglass.com/pricing
# Used for: Open Interest, Funding Rate, Long/Short Ratio, Liquidations
# Without this: OI/Funding/Liquidation use estimated data
COINGLASS_API_KEY=

# Whale Alert API (PAID — for cross-chain whale tracking)
# Get key: https://whale-alert.io/developers
# Used for: Large cross-chain transactions
WHALE_ALERT_API_KEY=

# Binance API (FREE — for order book data)
# Get key: https://www.binance.com/en/support/faq/how-to-create-api-keys-on-binance-360002531092
# Used for: Order book walls, real-time depth
BINANCE_API_KEY=
BINANCE_API_SECRET=
